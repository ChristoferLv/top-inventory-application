<header>
    <a href="/">
        <p>Compiltah Shop</p>
    </a>
    <a href="/products/add-product">
        <p>Add product</p>
    </a>
    <div class="categories-container">
        <% categories.map((category)=> { %>

            <a href="/products/<%-category.id%>">
                <div id=<%=category.id %> class="category-item">
                    <%= category.name %>
                </div>
            </a>
            <% }) %>
    </div>
</header>