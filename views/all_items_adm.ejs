<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" href="/favicon.svg" />
    <title>
        Compiltah Shop
    </title>

</head>

<body>
    <%- include("partials/header.ejs") %>
    <div class="adm-input">
        <p>Adm pass-key:</p>
        <input form="adm-actions" type="text" name="passKey">
    </div>
        <table>
            <caption>
                Items list
            </caption>
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Price</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Category</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>


                <% products.map((product)=> { %>

                    <tr>
                        <td>
                            <%= product.id %>
                        </td>
                        <td>
                            <%= product.name %>
                        </td>
                        <td>
                            <%= product.price %>
                        </td>
                        <td>
                            <%= product.amount %>
                        </td>
                        <td>
                            <%= product.category_id %> - <%= product.categoryname %>
                        </td>
                        <td>
                            <form id="adm-actions" action="/product/remove/<%= product.id %>" method="POST">
                                <input type="submit" value="Delete">
                            </form>
                        </td>
                    </tr>

                    <% }) %>
            </tbody>
        </table>


        <script>
        </script>
</body>

</html>