<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Compiltah Shop
    </title>
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" href="/favicon.svg" />

</head>

<body>
    <header>Compiltah Shop</header>
    <ul>
        <% products.map((product)=> { %>
            <li>
                <div id=<%=product.id %> class="product_item">
                    <%= product.id %>
                        <%= product.name %>
                            <%= product.price %>
                                <%= product.amount %>
                                    <%= product.category_id %>
                </div>
            </li>
            <% }) %>
    </ul>

    <script>
    </script>
</body>

</html>